# Banco de dados PostgreSQL
# Para maior carga, ajuste o pool na propria URL: pool_max_conns, pool_min_conns, pool_max_conn_lifetime.
DATABASE_URL=postgres://buildnix:buildnix@localhost:5432/buildnix?sslmode=disable

# JWT — obrigatório, mínimo 32 caracteres e valores diferentes
# Exemplo para gerar: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# JWT RSA — opcional. Quando preenchido, tokens usam RS256 e /.well-known/jwks.json fica disponível.
# Necessário quando o novo backend (runnix/flownix) for validar tokens do buildnix.
# Exemplo para gerar: openssl genrsa 2048 | awk 'NF {sub(/\r/, ""); printf "%s\\n",$0}' (use valor em linha única)
# Aceita PKCS8 (-----BEGIN PRIVATE KEY-----) ou PKCS1 (-----BEGIN RSA PRIVATE KEY-----).
JWT_RSA_PRIVATE_KEY=

# Usuário administrador inicial — usado apenas no bootstrap se ADMIN_EMAIL e ADMIN_SENHA estiverem preenchidos
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@buildnix.local
ADMIN_SENHA=troque-esta-senha

# OAuth2 Google — preencher no Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
# lax e o padrao recomendado para OAuth (Strict bloqueia o cookie no callback vindo do provider).
# Use none apenas em HTTPS quando o frontend estiver em outro dominio.
OAUTH_STATE_SAMESITE=lax

# Observer — URL do serviço central do ecossistema Sognix
# Deixe vazio para operar standalone (eventos serão logados localmente)
OBSERVER_URL=

# Logs em arquivo com rotação
LOG_FILE_PATH=./logs/buildnix-backend.log
LOG_MAX_SIZE_MB=50
LOG_MAX_AGE_DAYS=30
LOG_MAX_BACKUPS=10
LOG_COMPRESS=true
LOG_STDOUT=true

# Porta do servidor HTTP
SERVER_PORT=8080

# CORS — origens autorizadas separadas por virgula. Em producao, use os dominios reais do frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate limit distribuido — opcional. Em producao multi-instancia, configure Redis.
REDIS_URL=

# Numero de proxies reversos confiaveis na frente da aplicacao (nginx, Cloudflare, etc.).
# 0 (padrao) = ignora X-Forwarded-For e usa o IP da conexao, evitando spoofing de IP
# (que burlaria o rate-limit/login). Defina = numero de proxies para extrair o IP real do cliente.
TRUSTED_PROXY_COUNT=0

# Recuperacao de senha — mantenha false em producao; true apenas para desenvolvimento local/testes sem envio de email.
RESET_PASSWORD_RETURN_TOKEN=false
